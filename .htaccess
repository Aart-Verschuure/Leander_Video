Options -MultiViews
RewriteEngine On

# Startpagina als je alleen de map opent
DirectoryIndex homepage.php

# Oude links met .php doorsturen naar de versie zonder .php (bv. /contact.php -> /contact)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# /contact intern laten uitvoeren als contact.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
